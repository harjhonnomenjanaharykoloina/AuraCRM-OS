// ============================================================================
// Organization Membership (P0-1): Multi-org membership + active org switching
// ============================================================================

/// Multi-organization membership (P0-1). Enables a user to belong to >1 org and switch the
/// active organization. organizationId in the JWT session/user is the "current" org.
enum OrganizationMemberRole {
  org_admin
  org_manager
  org_member
}

model OrganizationMember {
  id             Int                    @id @default(autoincrement())
  userId         Int
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId Int
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrganizationMemberRole @default(org_member)
  isDefault      Boolean                @default(false)
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}


