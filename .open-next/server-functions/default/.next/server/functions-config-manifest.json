{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next\\/static|_next\\/image|favicon.ico|imgs\\/).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!_next/static|_next/image|favicon.ico|imgs/).*)"
        }
      ]
    },
    "/api/files/[id]": {},
    "/api/files/upload": {},
    "/app/[appApiName]/[objectApiName]/import/[jobId]/errors": {},
    "/app/[appApiName]/[objectApiName]/import/template": {}
  }
}