51-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\"></path><path d=\"M20 2v4\"></path><path d=\"M22 4h-4\"></path><circle cx=\"4\" cy=\"20\" r=\"2\"></circle></svg>Register<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right ml-1.5 h-4 w-4\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></a></div><div class=\"md:hidden\"><button data-slot=\"button\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive hover:bg-accent hover:text-accent-foreground dark:hover:bg-accent/50 size-9 h-9 w-9 border border-slate-200 bg-white\" aria-label=\"Open navigation menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-5 w-5\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></div></header><main class=\"relative z-10 pt-10\"><section id=\"about\" class=\"relative isolate flex flex-col items-center text-center scroll-mt-24 pb-12 sm:pb-16\"><div class=\"mx-auto mt-2 flex max-w-5xl flex-col items-center px-4 sm:px-6 lg:px-8\"><div class=\"text-center\"><p class=\"text-xs font-bold uppercase tracking-widest text-blue-600\">Overview</p><h2 class=\"poppins_44a67ff1-module__VktKBG__className mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl\">Open-Source CRM for Developers</h2><p class=\"mt-5 text-lg leading-relaxed text-slate-600 mx-auto max-w-3xl\">AuraCRM is an open-source, metadata-driven, multi-tenant CRM learning project for developers. It shows how objects, fields, pages, apps, permissions, and workflows can be shaped through configuration instead of being hardcoded into the product.</p></div><div class=\"mt-6 flex flex-wrap items-center justify-center gap-4\"><a href=\"https://github.com/ayas-ab/AuraCRM\" target=\"_blank\" rel=\"noopener noreferrer\"><button data-slot=\"button\" class=\"inline-flex items-center justify-center gap-2 whitespace-nowrap disabled:pointer-events-none disabled:opacity-50 [&amp;_svg]:pointer-events-none [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 shrink-0 [&amp;_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive border dark:bg-input/30 dark:border-input dark:hover:bg-input/50 h-10 has-[&gt;svg]:px-4 cursor-pointer rounded-full border-amber-400 bg-amber-300 px-6 py-4 text-sm font-semibold text-amber-950 shadow-md shadow-amber-200/80 transition-all duration-300 hover:-translate-y-1 hover:border-amber-500 hover:bg-amber-200 hover:text-amber-950 hover:shadow-lg hover:shadow-amber-200\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-github mr-2 h-5 w-5\" aria-hidden=\"true\"><path d=\"M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4\"></path><path d=\"M9 18c-4.51 2-5-2-7-2\"></path></svg>View Source Code / Download</button></a></div></div></section><section id=\"modules\" class=\"scroll-mt-24 border-y border-blue-50 bg-white/40 backdrop-blur-3xl py-24 relative\"><div class=\"mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10\"><div class=\"text-center\"><p class=\"text-xs font-bold uppercase tracking-widest text-blue-600\">Admin Control Surface</p><h2 class=\"poppins_44a67ff1-module__VktKBG__className mt-3 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl\">Configuration areas available in the app</h2><p class=\"mt-5 text-lg leading-relaxed text-slate-600 mx-auto max-w-3xl\">Everything below is implemented and available in the current codebase admin + standard surfaces, including the broader capability areas built on top of those configuration tools.</p></div><div class=\"mt-14 space-y-8\"><div class=\"grid gap-4 sm:grid-cols-2 lg:grid-cols-4\"><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-blocks h-5 w-5\" aria-hidden=\"true\"><path d=\"M10 22V7a1 1 0 0 0-1-1H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5a1 1 0 0 0-1-1H2\"></path><rect x=\"14\" y=\"2\" width=\"8\" height=\"8\" rx=\"1\"></rect></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">App Builder</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Create apps, brand them, and attach object navigation by team use case.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layout-dashboard h-5 w-5\" aria-hidden=\"true\"><rect width=\"7\" height=\"9\" x=\"3\" y=\"3\" rx=\"1\"></rect><rect width=\"7\" height=\"5\" x=\"14\" y=\"3\" rx=\"1\"></rect><rect width=\"7\" height=\"9\" x=\"14\" y=\"12\" rx=\"1\"></rect><rect width=\"7\" height=\"5\" x=\"3\" y=\"16\" rx=\"1\"></rect></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Dashboards</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Configure metric/list/chart widgets with typed filters and owner scopes.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-up h-5 w-5\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M12 12v6\"></path><path d=\"m15 15-3-3-3 3\"></path></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Data Loading</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Bulk insert/update/upsert via external IDs with tracked import jobs and row errors.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-lock h-5 w-5\" aria-hidden=\"true\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Permissions</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Grant object-level CRUD, View All, Modify All, and app access by permission set.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-5 w-5\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Permission Set Groups</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Bundle permission sets into assignable groups for cleaner access administration.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-workflow h-5 w-5\" aria-hidden=\"true\"><rect width=\"8\" height=\"8\" x=\"3\" y=\"3\" rx=\"2\"></rect><path d=\"M7 11v4a2 2 0 0 0 2 2h4\"></path><rect width=\"8\" height=\"8\" x=\"13\" y=\"13\" rx=\"2\"></rect></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Sharing Rules</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Materialize group access to user-owned records using criteria and access level.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check h-5 w-5\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Duplicate Rules</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Detect likely duplicates on create and edit with multi-field matching plus warn or block actions.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-git-branch h-5 w-5\" aria-hidden=\"true\"><line x1=\"6\" x2=\"6\" y1=\"3\" y2=\"15\"></line><circle cx=\"18\" cy=\"6\" r=\"3\"></circle><circle cx=\"6\" cy=\"18\" r=\"3\"></circle><path d=\"M18 9a9 9 0 0 1-9 9\"></path></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Assignment Rules</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Route new records to a user or queue with ordered, first-match criteria logic.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-5 w-5\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Groups</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Organize users for sharing targets and ownership-based access modeling.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-bell h-5 w-5\" aria-hidden=\"true\"><path d=\"M10.268 21a2 2 0 0 0 3.464 0\"></path><path d=\"M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326\"></path></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Queues</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Use queue ownership buckets and claim flow for distributed intake and triage.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users h-5 w-5\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><path d=\"M16 3.128a4 4 0 0 1 0 7.744\"></path><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Record Ownership Enforcement</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Record ownership is enforced at row level: user-owned, queue-owned, claim flow, and share-aware access checks.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layout-dashboard h-5 w-5\" aria-hidden=\"true\"><rect width=\"7\" height=\"9\" x=\"3\" y=\"3\" rx=\"1\"></rect><rect width=\"7\" height=\"5\" x=\"14\" y=\"3\" rx=\"1\"></rect><rect width=\"7\" height=\"9\" x=\"14\" y=\"12\" rx=\"1\"></rect><rect width=\"7\" height=\"5\" x=\"3\" y=\"16\" rx=\"1\"></rect></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">List Views</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Configure saved filters, columns, sorting, sharing, pinning, and custom logic expressions per object.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-history h-5 w-5\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8\"></path><path d=\"M3 3v5h5\"></path><path d=\"M12 7v5l4 2\"></path></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Audit Trail</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Track field changes and owner transitions with timestamped history for accountability and compliance.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database h-5 w-5\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Objects</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Manage object identity, behavior flags, metadata-level governance, and where-used delete protection.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles h-5 w-5\" aria-hidden=\"true\"><path d=\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\"></path><path d=\"M20 2v4\"></path><path d=\"M22 4h-4\"></path><circle cx=\"4\" cy=\"20\" r=\"2\"></circle></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Fields &amp; Types</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Define typed fields, options, external IDs, uniqueness, lookup targets, and field where-used checks.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check h-5 w-5\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Validation Rules</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Protect data integrity with per-object condition logic and field constraints.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layers h-5 w-5\" aria-hidden=\"true\"><path d=\"M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z\"></path><path d=\"M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12\"></path><path d=\"M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17\"></path></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Record Pages</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Assign record page layouts per app and permission context with visibility rules.</p></div></div></article><article class=\"group rounded-2xl border border-white bg-white/60 p-5 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex flex-col items-start gap-4\"><div class=\"rounded-xl border border-blue-50 bg-blue-50/50 p-2.5 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check h-5 w-5\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><div><h4 class=\"text-base font-bold text-slate-900\">Delete Safety</h4><p class=\"mt-2 text-sm leading-relaxed text-slate-600\">Block object/field deletes when metadata still depends on them, with grouped where-used diagnostics.</p></div></div></article></div><div class=\"rounded-3xl border border-white/60 bg-white/60 p-6 sm:p-8 backdrop-blur-xl shadow-xl shadow-blue-100/50\"><h3 class=\"poppins_44a67ff1-module__VktKBG__className text-xl font-bold text-slate-900\">Capability coverage</h3><p class=\"mt-2 text-sm text-slate-600\">The same configuration layer powers the broader platform capabilities below, from data modeling and validation to access, automation, collaboration, and productivity UX.</p><div class=\"mt-8 grid gap-6 lg:grid-cols-2 xl:grid-cols-3\"><article class=\"group relative rounded-3xl border border-white bg-white/60 p-7 shadow-sm backdrop-blur-md transition-all duration-300 ease-out hover:-translate-y-1 hover:border-blue-100 hover:bg-white hover:shadow-xl hover:shadow-blue-100/50\"><div class=\"flex items-start gap-4\"><div class=\"rounded-2xl border border-blue-50 bg-blue-50/50 p-3 text-blue-600 transition-transform duration-300 group-hover:scale-110 group-hover:bg-blue-100\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database h-6 w-6\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg></div><div><h3 class=\"poppins_44a67ff1-module__VktKBG__className text-xl font-bold text-slate-900\">Metadata Platform</h3><p class=\"mt-1 text-sm text-slate-500\">Build your CRM model at runtime</p></div></div><ul class=\"mt-8 space-y-3\"><li class=\"flex items-start gap-3 text-sm leading-relaxed text-slate-600\"><span class=\"mt-[3px] text-blue-500\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check h-4 w-4\" aria-